### 프로필 생성
POST http://{{domain}}:{{port}}/api/profiles
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJqdGkiOiIwMDdmYWQ0Zi1hMTRhLTQ4MWEtOTI4Zi01YzczYzAzZDNmYmEiLCJzdWIiOiI3NGI5YWYwNy03NjI2LTQ3ZWQtOWQzMy1lZGVmYWJlYmM4NGEiLCJyb2xlIjoiVVNFUiIsIm5hbWUiOiLthYzsiqTtirjsnKDsoIAiLCJpYXQiOjE3ODQ0NDk0ODMsImV4cCI6MTc4NDQ1MzA4M30.wK-vJdo3jar1u25cRZGN7gmwZVGDH0uHbsrG93OAN1C35tDi-aqx2bNUqVKjUoEXX7055cJB4ZDXYpdsq2-x6g

{
  "gender": "MALE",
  "birthday": "19940225",
  "bio": "아하?",
  "tags": ["넷플릭스"],
  "prefGender": "FEMALE",
  "prefAgeMin": 20,
  "prefAgeMax": 22,
  "prefDistanceKm": 5
}

### 이미지 업로드 (단일)
# mainIndex 는 쿼리 파라미터로 전달 (파일+텍스트 폼 필드 혼용 시 IntelliJ Content-Length 버그 회피)
POST http://{{domain}}:{{port}}/api/profiles/{{profileId}}/images?mainIndex=0
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJqdGkiOiJkYTY0YWRkYi04MzU4LTQwY2ItODRmYy00Zjk0NjVmOGFlNTQiLCJzdWIiOiI3NGI5YWYwNy03NjI2LTQ3ZWQtOWQzMy1lZGVmYWJlYmM4NGEiLCJyb2xlIjoiVVNFUiIsIm5hbWUiOiLthYzsiqTtirjsnKDsoIAiLCJpYXQiOjE3ODQ5Nzk5ODUsImV4cCI6MTc4NDk4MzU4NX0.hxQE6QPcfyiAB94RIj9nnmIIQsepMSR6KOpdrlaQmry6tpp0-SEMwY5COpYKk2foXm8EddlsL2T9nwVh_DdsKw
Content-Type: multipart/form-data; boundary=boundary
Connection: close

--boundary
Content-Disposition: form-data; name="images"; filename="profile1.jpg"
Content-Type: image/jpeg

< ./images/profile1.jpg
--boundary--

### 이미지 업로드 (여러 장)
# mainIndex 는 쿼리 파라미터로 전달한다.
# (IntelliJ HTTP Client 2025.1.x 버그: 파일 파트 + 텍스트 폼 필드를 섞으면
#  Content-Length 를 작게 계산해 서버에서 "Stream ended unexpectedly" 발생.
#  @RequestParam 은 쿼리에서도 바인딩되므로 컨트롤러 변경 불필요.)
POST http://{{domain}}:{{port}}/api/profiles/{{profileId}}/images?mainIndex=1
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJqdGkiOiJkYTY0YWRkYi04MzU4LTQwY2ItODRmYy00Zjk0NjVmOGFlNTQiLCJzdWIiOiI3NGI5YWYwNy03NjI2LTQ3ZWQtOWQzMy1lZGVmYWJlYmM4NGEiLCJyb2xlIjoiVVNFUiIsIm5hbWUiOiLthYzsiqTtirjsnKDsoIAiLCJpYXQiOjE3ODQ5Nzk5ODUsImV4cCI6MTc4NDk4MzU4NX0.hxQE6QPcfyiAB94RIj9nnmIIQsepMSR6KOpdrlaQmry6tpp0-SEMwY5COpYKk2foXm8EddlsL2T9nwVh_DdsKw
Content-Type: multipart/form-data; boundary=boundary
Connection: close

--boundary
Content-Disposition: form-data; name="images"; filename="profile2.jpg"
Content-Type: image/jpeg

< ./images/profile2.jpg
--boundary
Content-Disposition: form-data; name="images"; filename="profile3.jpg"
Content-Type: image/jpeg

< ./images/profile3.jpg
--boundary--



### 위치 업데이트 (F0-2)
# profile_location UPSERT + Redis GEOADD geo:users. X-User-Id 소유권 검증.
# (게이트웨이 경유 시 X-User-Id 는 JWT 에서 주입됨 — 직접 호출 테스트용으로 명시)
PUT http://{{domain}}:{{port}}/api/profiles/{{profileId}}/location
X-User-Id: 74b9af07-7626-47ed-9d33-edefabebc84a
Content-Type: application/json

{
  "lat": 37.501274,
  "lng": 127.039585
}

### 태그 피커 - 키워드 검색 (F0-5)
# 게이트웨이 JwtAuthentication 필터가 /api/tags 도 토큰을 요구 → Authorization 필요
GET http://{{domain}}:{{port}}/api/tags?q=자바
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJqdGkiOiJkYTY0YWRkYi04MzU4LTQwY2ItODRmYy00Zjk0NjVmOGFlNTQiLCJzdWIiOiI3NGI5YWYwNy03NjI2LTQ3ZWQtOWQzMy1lZGVmYWJlYmM4NGEiLCJyb2xlIjoiVVNFUiIsIm5hbWUiOiLthYzsiqTtirjsnKDsoIAiLCJpYXQiOjE3ODQ5Nzk5ODUsImV4cCI6MTc4NDk4MzU4NX0.hxQE6QPcfyiAB94RIj9nnmIIQsepMSR6KOpdrlaQmry6tpp0-SEMwY5COpYKk2foXm8EddlsL2T9nwVh_DdsKw

